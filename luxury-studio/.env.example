# ── Public (client bundle) ──────────────────────────────────
# These are exposed to the browser via Vite — do NOT put secrets here.
VITE_SANITY_PROJECT_ID=your_project_id
VITE_SANITY_DATASET=production

# ── Server-side only (Vercel Functions) ────────────────────
# These are NEVER exposed to the client. Set them in your
# Vercel dashboard → Settings → Environment Variables.
ADMIN_PASSWORD=          # Admin panel login password
SANITY_WRITE_TOKEN=      # Sanity API token with write access (Editor role)
SANITY_PROJECT_ID=your_project_id
SANITY_DATASET=production
SESSION_SECRET=          # Random string used to sign auth tokens (generate: openssl rand -hex 32)

# ── Sanity Studio ──────────────────────────────────────────
SANITY_STUDIO_PROJECT_ID=your_project_id
SANITY_STUDIO_DATASET=production
